{
  "name": "@computerwwwizards/example-ui",
  "version": "0.0.1",
  "description": "UI components library built with tinkuy-react bridge",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "style": "./src/styles.css",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "style": "./src/styles.css",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "style": "./src/styles.css",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "style": "./src/styles.css",
        "import": "./dist/index.js"
      },
      "./styles.css": "./src/styles.css"
    }
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@computerwwwizards/tinkuy-react": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@rslib/core": "^1.0.0",
    "@storybook/react": "^8.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "storybook": "^8.0.0",
    "storybook-react-rsbuild": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
